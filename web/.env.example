# Algolia: só a search key vai para o front. Em produção, uma chave restrita criada no dashboard
# (ACL search, índices produtos_ptbr*, referers, rate limit por IP, validade). Nunca a Write key.
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX=produtos_ptbr
NEXT_PUBLIC_ALGOLIA_INDEX_EN=produtos_en

# Assistente (Agent Studio). Chave própria do chat: ACL search, índices produtos_ptbr* e produtos_en*,
# maxHitsPerQuery, validade, SEM referer e SEM limite por IP (o agente busca dos servidores da Algolia e
# recusa a chave do site com 401). O gasto com o LLM fica no rate limit e nos approved domains do agente.
# Sem estas duas, o chat não aparece.
NEXT_PUBLIC_ALGOLIA_AGENT_ID=
NEXT_PUBLIC_ALGOLIA_CHAT_KEY=
