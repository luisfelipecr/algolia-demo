# Algolia (dashboard > Settings > API Keys). Nenhuma chave de escrita vai para o front.
ALGOLIA_APP_ID=
# Search API Key: só leitura. A padrão do dashboard serve para desenvolvimento local; o front público usa
# uma chave restrita (índices, referers, rate limit por IP, validade), criada antes do deploy.
ALGOLIA_SEARCH_API_KEY=
# Write API Key: indexação e configuração do índice pelo ingest/. A admin key não é necessária.
ALGOLIA_WRITE_API_KEY=
ALGOLIA_INDEX=produtos_ptbr
# Loja em inglês (/en); o copiloto lê as duas lojas
ALGOLIA_INDEX_EN=produtos_en

# Agent Studio: id do agente publicado (o provedor de LLM é configurado no dashboard da Algolia)
ALGOLIA_AGENT_ID=
# Chave só do chat (search, produtos_*, sem referer e sem limite por IP); ver web/.env.example
ALGOLIA_CHAT_KEY=

# MCP do merchandiser
MCP_BASE_URL=http://localhost:8000
# Copiloto público (segredo no Fly): só analytics e browse; o modo público recusa a Write key
ALGOLIA_COPILOTO_KEY=

# Tráfego sintético (sintetico/): só search, com analyticsTags=sintetico imposto nos queryParameters da chave
ALGOLIA_SINTETICO_KEY=

# Avisos de "quando chegar" do assistente (copiloto, /loja/mcp): só addObject em produtos_ptbr_avisos
ALGOLIA_AVISOS_KEY=
